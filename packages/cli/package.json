{
  "name": "@b10cks/cli",
  "version": "1.2.0",
  "description": "CLI to interact with the b10cks Management API",
  "license": "MIT",
  "author": "Michael Wallner @ Coder's Cantina",
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/cli"
  },
  "bin": {
    "b10cks": "dist/index.mjs"
  },
  "files": [
    "dist/**"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "unbuild",
    "dev": "bun run build && ./dist/index.mjs",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b10cks/mgmt-client": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "figlet": "^1.11.0",
    "inquirer": "^13.3.2",
    "netrc": "^0.1.4",
    "ora": "^9.3.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^24.13.2",
    "@types/update-notifier": "^6.0.8",
    "unbuild": "^3.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
