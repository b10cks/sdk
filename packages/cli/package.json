{
  "name": "@b10cks/cli",
  "version": "2.0.0",
  "description": "CLI to interact with the b10cks Management API",
  "keywords": [
    "b10cks",
    "cli",
    "cms",
    "content-management",
    "headless-cms",
    "management-api",
    "scaffolding"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/cli"
  },
  "bin": {
    "b10cks": "dist/index.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "unbuild",
    "dev": "bun run build && ./dist/index.mjs",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b10cks/mgmt-client": "workspace:*",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/update-notifier": "^6.0.8",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "giget": "^3.3.1",
    "inquirer": "^14.0.2",
    "magicast": "^0.5.3",
    "netrc": "^0.1.4",
    "ora": "^9.4.1",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
