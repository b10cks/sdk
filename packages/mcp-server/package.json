{
  "name": "@b10cks/mcp-server",
  "version": "0.9.0",
  "description": "MCP server for the b10cks headless CMS Management API — block definitions, content, redirects, data sources, releases, automations and more",
  "keywords": [
    "ai",
    "b10cks",
    "claude",
    "cms",
    "content-management",
    "cursor",
    "headless-cms",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/mcp-server"
  },
  "bin": {
    "b10cks-mcp-server": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@b10cks/mgmt-client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
