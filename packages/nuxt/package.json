{
  "name": "@b10cks/nuxt",
  "version": "3.3.0",
  "description": "b10cks Nuxt client SDK",
  "keywords": [
    "b10cks",
    "cms",
    "headless-cms",
    "nuxt",
    "nuxt-module",
    "sdk",
    "vue"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@b10cks/client": "workspace:^",
    "@b10cks/richtext": "workspace:^",
    "@b10cks/vue": "workspace:^",
    "@nuxt/kit": "^4.5.0",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.0",
    "nuxt": "^4.5.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
