{
  "name": "@b10cks/nuxt",
  "version": "3.2.1",
  "description": "b10cks Nuxt client SDK",
  "license": "MIT",
  "author": "Michael Wallner @ Coder's Cantina",
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/nuxt"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist",
    "typecheck": "nuxt-module-build prepare && vue-tsc --noEmit"
  },
  "dependencies": {
    "@b10cks/client": "workspace:^",
    "@b10cks/richtext": "workspace:^",
    "@b10cks/vue": "workspace:^",
    "@nuxt/kit": "^4.4.8"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "nuxt": "^4.4.8",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.6"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
