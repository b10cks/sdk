{
  "name": "@b10cks/richtext",
  "version": "0.6.1",
  "description": "Framework-agnostic rich text rendering for b10cks Rich text",
  "keywords": [
    "b10cks",
    "cms",
    "headless-cms",
    "renderer",
    "rich-text",
    "sdk"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/richtext"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.12",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
