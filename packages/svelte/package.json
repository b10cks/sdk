{
  "name": "@b10cks/svelte",
  "version": "0.7.0",
  "description": "Svelte SDK for integrating b10cks into Svelte applications",
  "keywords": [
    "b10cks",
    "cms",
    "headless-cms",
    "sdk",
    "svelte",
    "sveltekit"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/svelte"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@b10cks/client": "workspace:^",
    "@b10cks/richtext": "workspace:^"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
