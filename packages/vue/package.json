{
  "name": "@b10cks/vue",
  "version": "2.4.3",
  "description": "SDK to integrate b10cks into your vue applications",
  "license": "MIT",
  "author": "Michael Wallner @ Coder's Cantina",
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/vue"
  },
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.mjs",
      "require": "./dist/rich-text.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b10cks/client": "workspace:^",
    "@b10cks/richtext": "workspace:^"
  },
  "devDependencies": {
    "@vue/language-core": "^3.3.6",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6"
  },
  "peerDependencies": {
    "vue": "^3.5.21"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
