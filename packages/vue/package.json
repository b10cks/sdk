{
  "name": "@b10cks/vue",
  "version": "2.6.0",
  "description": "SDK to integrate b10cks into your vue applications",
  "keywords": [
    "b10cks",
    "cms",
    "headless-cms",
    "sdk",
    "vue"
  ],
  "homepage": "https://www.b10cks.com",
  "bugs": {
    "url": "https://github.com/b10cks/sdk/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Wallner",
    "email": "m.wallner@coderscantina.com",
    "url": "https://github.com/b10cks"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/b10cks/sdk.git",
    "directory": "packages/vue"
  },
  "source": "src/index.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.mjs",
      "require": "./dist/rich-text.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint src",
    "clean": "rm -rf dist",
    "lint:fix": "oxlint --fix src",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@b10cks/client": "workspace:^",
    "@b10cks/richtext": "workspace:^"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/language-core": "^3.3.8",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  },
  "peerDependencies": {
    "vue": "^3.5.21"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
